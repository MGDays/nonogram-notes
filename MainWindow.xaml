<Window x:Class="NonogramNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NonogramNotes"
        Title="Nonogram Notes" Width="1000" Height="800"
        UseLayoutRounding="True" KeyDown="Window_KeyDown">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="Rows" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="RowsBox" Width="36" Text="10" VerticalContentAlignment="Center"/>
                <TextBlock Text="Columns" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="ColumnsBox" Width="36" Text="10" VerticalContentAlignment="Center"/>
                <Button Content="Resize" Click="ResizeButton_Click" Margin="4,0" Padding="6,2"/>
                <Separator/>
                <Button Content="Undo" Click="UndoButton_Click" ToolTip="Ctrl+Z" Padding="6,2"/>
                <Button Content="Redo" Click="RedoButton_Click" ToolTip="Ctrl+Y" Padding="6,2"/>
                <Separator/>
                <Button Content="Clear marks" Click="ClearMarksButton_Click" Padding="6,2"/>
                <Button Content="Clear clues" Click="ClearCluesButton_Click" Padding="6,2"/>
                <Separator/>
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="4,0"/>
                <Slider x:Name="ZoomSlider" Width="140" Minimum="12" Maximum="48" Value="24"
                        TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ToolTip="Ctrl+Mouse wheel"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" MinWidth="220"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="Gray"
                           Text="Left-click: fill · Right-click: cross · Drag: mark a line · Space/Enter in a clue: next number"/>
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#F3F3F3" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Grid Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Margins of 1 line the clue boxes up with the grid's outer border. -->
                <StackPanel x:Name="ColumnCluePanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,1,3"/>
                <StackPanel x:Name="RowCluePanel" Grid.Row="1" Grid.Column="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,3,1"/>
                <local:NonogramGrid x:Name="Board" Grid.Row="1" Grid.Column="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
